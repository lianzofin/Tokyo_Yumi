@page "/"
@inject NavigationManager Nav

<PageTitle>טוקיו-יומי | Tokyo-Yumi</PageTitle>

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .hero-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: linear-gradient(rgba(142, 51, 43, 0.85), rgba(0,0,0,0.75)), url('tokyo_GIF.gif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        z-index: 1;
    }

    .content-box {
        position: relative;
        z-index: 2;
        color: white;
        margin-right: 10%;
        max-width: 600px;
        direction: rtl;
        text-align: right;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        animation: fadeIn 0.8s ease-out;
    }

    .welcome-logo {
        width: 180px;
        margin-bottom: 20px;
        /* הוספת צל ללוגו - עובד מעולה על PNG שקוף */
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.6));
    }

    h1 {
        font-size: 3.5rem;
        font-weight: 800;
        margin: 0;
        line-height: 1.1;
    }

    p.lead-text {
        font-size: 1.4rem;
        font-weight: 300;
        margin: 15px 0 40px 0;
        opacity: 0.95;
    }

    .actions {
        display: flex;
        gap: 15px;
        margin-bottom: 50px;
    }

    .tokyo-btn {
        width: 220px;
        height: 55px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .primary {
        background-color: #8E332B;
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

        .primary:hover {
            background-color: #a33b32;
            transform: translateY(-2px);
        }

    .outline {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
        border: 2px solid white;
        backdrop-filter: blur(5px);
    }

        .outline:hover {
            background-color: white;
            color: #8E332B;
        }

    .stats-row {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgba(255,255,255,0.2);
        padding-top: 30px;
        margin-top: 20px;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        flex: 1;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
    }

    .stat-label {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.7);
        margin: 0;
        font-weight: 400;
    }

    /* עיצוב הטקסט בצד (פוטר) */
    .side-footer {
        position: absolute;
        bottom: 30px;
        right: 10%;
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
        direction: rtl;
        z-index: 2;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateX(30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@media (max-width: 768px) {
        .hero-wrapper {
            justify-content: center;
        }

        .content-box {
            margin-right: 0;
            text-align: center;
            padding: 20px;
        }

        .actions {
            flex-direction: column;
            align-items: center;
        }

        .stats-row {
            flex-wrap: wrap;
            gap: 20px;
        }

        .stat-item {
            flex: unset;
            width: 40%;
        }

        h1 {
            font-size: 2.6rem;
        }

        .side-footer {
            right: 0;
            width: 100%;
            text-align: center;
            bottom: 15px;
        }
    }
</style>

<div class="hero-wrapper">
    <div class="content-box">
        <img src="images/logo3.png" class="welcome-logo" alt="טוקיו-יומי" />
            <h1>הסיפור שלכם בטוקיו מתחיל כאן.</h1>
        <p class="lead-text">לחוות את טוקיו כמו שמעולם לא דמיינתם, בטוקיו-יומי!</p>

        <div class="actions">
            <a class="tokyo-btn primary" href="/login">כניסה למערכת</a>
            <a class="tokyo-btn outline" href="/register">הרשמה בחינם</a>
        </div>

        <div class="stats-row">
            <div class="stat-item">
                <p class="stat-number">50+</p>
                <p class="stat-label">אטרקציות</p>
            </div>
            <div class="stat-item">
                <p class="stat-number">24/7</p>
                <p class="stat-label">מידע זמין</p>
            </div>
            <div class="stat-item">
                <p class="stat-number">100%</p>
                <p class="stat-label">דיוק במיקום</p>
            </div>
            <div class="stat-item">
                <p class="stat-number">חינם</p>
                <p class="stat-label">שימוש מלא</p>
            </div>
        </div>
    </div>
</div>