@code {
    /* פונקציית Lifecycle של Blazor שרצה לאחר שה-HTML רונדר בדפדפן */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // קריאה לפונקציית ה-JavaScript שמפעילה את האנימציה בטקסט ה-Hero
            await JSRuntime.InvokeVoidAsync("startTextAnimation");
        }
    }
}

<script>
    // רשימת שמות האטרקציות שיופיעו באנימציה
    const texts = [
        "צומת שיבויה", "מקדש סנסו-ג'י", "פארק אואנו", "גני שינג'וקו גיאואן",
        "רובע גינזה", "מוזיאון מורי ארט", "שוק הדגים טויוסו", "מגדל סקייטרי",
        "סאנשיין סיטי", "דיסנילנד טוקיו", "מוזיאון אדו-טוקיו", "אקיהברה",
        "גן החיות אואנו", "אודייבה", "מקדש מייג'י", "רחוב טאקשיטה",
        "שוק אמייוקו", "קבוקיצ'ו", "גשר ריינבואו", "שיבויה סקיי"
    ];

    // פונקציה להחלפת הטקסט בצורה רנדומלית
    function changeText() {
        const element = document.getElementById("hero-text");
        if (element) {
            const randomText = texts[Math.floor(Math.random() * texts.length)];
            element.textContent = randomText;
        }
    }

    // פונקציה שמתחילה את הלולאה (נקראת מה-C# למעלה)
    window.startTextAnimation = function() {
        changeText(); // הפעלה ראשונית
        setInterval(changeText, 500); // שינוי כל חצי שנייה
    };

        // הפעלה אוטומטית כשהדף נטען
    document.addEventListener("DOMContentLoaded", function() {
        window.startTextAnimation();
    });
</script>